{
  "name": "react-sketch-project",
  "description": "Monorepo for react-sketch, a sketch element for React applications backed by fabric.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "yarn workspace showcase start",
    "build": "yarn workspace react-sketch build && yarn workspace showcase build",
    "typecheck": "yarn workspace react-sketch typecheck && yarn workspace showcase typecheck",
    "clean": "node -e \"for (const d of ['packages/react-sketch/dist', 'packages/showcase/build']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn workspace react-sketch test",
    "test:watch": "yarn workspace react-sketch test --watch",
    "test:coverage": "yarn workspace react-sketch test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml}": "prettier --write"
  }
}
