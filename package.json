{
  "name": "react-sketch-project",
  "description": "Monorepo for react-sketch, a sketch element for React applications backed by fabric.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "wsrun start",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^17.0.3",
    "@types/react-dom": "^17.0.3",
    "awesome-typescript-loader": "^5.2.1",
    "css-loader": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "source-map-loader": "^2.0.1",
    "typescript": "^4.2.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.30.0",
    "wsrun": "^5.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml}": "prettier --write"
  }
}
