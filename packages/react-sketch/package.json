  },
  "devDependencies": {
    "@types/fabric": "^4.2.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-loader": "^9.6.2"
  }
